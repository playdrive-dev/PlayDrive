<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <!-- AAOS CarPropertyManager -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />      <!-- PERF_VEHICLE_SPEED (dangerous) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" /> <!-- GEAR_SELECTION -->
    <!-- Pleos Vehicle SDK (읽기 전용) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />  <!-- TurnSignal -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />   <!-- Brake, SteeringWheel angle -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" /> <!-- Wiper -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />   <!-- Seat occupancy -->
    <!-- Pleos NaviHelper 3.0.5: 회전 안내(TBT)·남은 거리·도착·제한속도 읽기 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- Pleos TextToSpeech 3.3.1(ON_DEVICE): 음성 안내 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.PlayDrive">

        <!-- Pleos 창 정책(Connect-S 1:1, Connect-W 2:1·1:2, 가로/세로 전환): 창 크기가 바뀌어도 다시 만들지 않는다(음악·물결이 이어지게) → MainActivity가 창 비율로 레이아웃을 다시 고른다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중 화면 허용(Distraction Optimization). 화면 정책은 7단계에서 CarUxRestrictions와 함께 구현 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>
</manifest>
